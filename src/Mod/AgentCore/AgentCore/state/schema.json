{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mel-1989/FreeCAD/agentcore/state/1/schema.json",
  "title": "AgentCore document state",
  "description": "Versioned, paged JSON view of a FreeCAD document (AgentCore.state.dump). Lengths are mm, angles in placements are quaternions, quantities carry their internal-unit value and unit type.",
  "license": "SPDX-License-Identifier: LGPL-2.1-or-later",
  "version": "agentcore.state/1",
  "type": "object",
  "required": ["schema", "generator", "document", "paging", "objects"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "agentcore.state/1"},
    "generator": {
      "type": "object",
      "required": ["freecad", "agentcore_state"],
      "additionalProperties": false,
      "properties": {"freecad": {"type": "string"}, "agentcore_state": {"type": "string"}}
    },
    "document": {
      "type": "object",
      "required": ["name", "label", "object_count", "roots", "meta"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "label": {"type": "string"},
        "object_count": {"type": "integer", "minimum": 0},
        "roots": {"$ref": "#/$defs/names"},
        "meta": {"type": "object", "additionalProperties": {"type": ["string", "number"]}}
      }
    },
    "paging": {
      "type": "object",
      "required": ["page", "page_size", "total", "pages"],
      "additionalProperties": false,
      "properties": {
        "page": {"type": "integer", "minimum": 0},
        "page_size": {"type": "integer", "minimum": 1},
        "total": {"type": "integer", "minimum": 0},
        "pages": {"type": "integer", "minimum": 1}
      }
    },
    "objects": {"type": "array", "items": {"$ref": "#/$defs/object"}}
  },
  "$defs": {
    "names": {"type": "array", "items": {"type": "string"}},
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3},
    "intlist": {"type": "array", "items": {"type": "integer"}},
    "nullable_string": {"type": ["string", "null"]},
    "link": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "required": ["object"], "properties": {"object": {"type": "string"}, "subs": {"$ref": "#/$defs/names"}}},
        {"type": "array"}
      ]
    },
    "error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "string"}}},
    "property": {
      "type": "object",
      "required": ["name", "type", "group", "value"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"},
        "group": {"type": "string"},
        "value": true,
        "enum": {"$ref": "#/$defs/names"}
      }
    },
    "expression": {
      "type": "object",
      "required": ["path", "expression"],
      "additionalProperties": false,
      "properties": {"path": {"type": "string"}, "expression": {"type": "string"}}
    },
    "shape": {
      "anyOf": [
        {"type": "null"},
        {"type": "object", "required": ["null"], "properties": {"null": {"const": true}}, "additionalProperties": false},
        {
          "type": "object",
          "required": ["null", "shape_type", "solids", "shells", "faces", "edges", "vertexes", "volume", "area", "bbox", "element_map_size", "valid"],
          "additionalProperties": false,
          "properties": {
            "null": {"const": false},
            "shape_type": {"type": "string"},
            "solids": {"type": "integer", "minimum": 0},
            "shells": {"type": "integer", "minimum": 0},
            "faces": {"type": "integer", "minimum": 0},
            "edges": {"type": "integer", "minimum": 0},
            "vertexes": {"type": "integer", "minimum": 0},
            "volume": {"type": ["number", "null"]},
            "area": {"type": ["number", "null"]},
            "bbox": {"anyOf": [{"type": "null"}, {"type": "array", "items": {"type": "number"}, "minItems": 6}]},
            "element_map_size": {"type": "integer", "minimum": 0},
            "valid": {"type": ["boolean", "null"]}
          }
        }
      ]
    },
    "kind": {"enum": ["sketch", "spreadsheet", "varset", "body", "assembly", "joint", "techdraw_page", "techdraw_view", "techdraw_dimension", "partdesign_feature", "origin", "part_feature", "group", "other"]},
    "object": {
      "type": "object",
      "required": ["name", "label", "type", "kind", "proxy", "state", "in_list", "out_list", "properties", "expressions", "shape", "detail"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "label": {"type": "string"},
        "type": {"type": "string"},
        "kind": {"$ref": "#/$defs/kind"},
        "proxy": {"$ref": "#/$defs/nullable_string"},
        "state": {"$ref": "#/$defs/names"},
        "in_list": {"$ref": "#/$defs/names"},
        "out_list": {"$ref": "#/$defs/names"},
        "properties": {"type": "array", "items": {"$ref": "#/$defs/property"}},
        "expressions": {"type": "array", "items": {"$ref": "#/$defs/expression"}},
        "shape": {"$ref": "#/$defs/shape"},
        "detail": {
          "anyOf": [
            {"type": "null"},
            {"$ref": "#/$defs/error"},
            {"$ref": "#/$defs/sketch"},
            {"$ref": "#/$defs/spreadsheet"},
            {"$ref": "#/$defs/varset"},
            {"$ref": "#/$defs/body"},
            {"$ref": "#/$defs/assembly"},
            {"$ref": "#/$defs/joint"},
            {"$ref": "#/$defs/techdraw_page"},
            {"$ref": "#/$defs/techdraw_dimension"},
            {"$ref": "#/$defs/techdraw_view"}
          ]
        }
      }
    },
    "sketch": {
      "type": "object",
      "required": ["solver", "geometry", "constraints", "dependent_parameters", "external_geometry", "attachment"],
      "additionalProperties": false,
      "properties": {
        "solver": {
          "type": "object",
          "required": ["status", "dof", "fully_constrained", "conflicting", "redundant", "partially_redundant", "malformed"],
          "additionalProperties": false,
          "properties": {
            "status": {"type": ["integer", "null"]},
            "dof": {"type": ["integer", "null"]},
            "fully_constrained": {"type": "boolean"},
            "conflicting": {"$ref": "#/$defs/intlist"},
            "redundant": {"$ref": "#/$defs/intlist"},
            "partially_redundant": {"$ref": "#/$defs/intlist"},
            "malformed": {"$ref": "#/$defs/intlist"}
          }
        },
        "geometry": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "type", "construction"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "type": {"type": "string"},
              "construction": {"type": "boolean"},
              "startPoint": {"$ref": "#/$defs/vec3"},
              "endPoint": {"$ref": "#/$defs/vec3"},
              "center": {"$ref": "#/$defs/vec3"},
              "radius": {"type": "number"}
            }
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "type", "name", "first", "first_pos", "second", "second_pos", "third", "third_pos", "value", "driving", "active"],
            "additionalProperties": false,
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "type": {"type": "string"},
              "name": {"type": "string"},
              "first": {"type": "integer"}, "first_pos": {"type": "integer"},
              "second": {"type": "integer"}, "second_pos": {"type": "integer"},
              "third": {"type": "integer"}, "third_pos": {"type": "integer"},
              "value": {"type": "number"},
              "driving": {"type": "boolean"},
              "active": {"type": "boolean"}
            }
          }
        },
        "dependent_parameters": {"type": "array", "items": {"$ref": "#/$defs/intlist"}},
        "external_geometry": {
          "type": "array",
          "items": {"type": "object", "required": ["object", "sub"], "additionalProperties": false, "properties": {"object": {"type": "string"}, "sub": {"type": "string"}}}
        },
        "attachment": {
          "type": "object",
          "required": ["support", "map_mode"],
          "additionalProperties": false,
          "properties": {"support": {"$ref": "#/$defs/link"}, "map_mode": {"$ref": "#/$defs/nullable_string"}}
        }
      }
    },
    "spreadsheet": {
      "type": "object",
      "required": ["cells"],
      "additionalProperties": false,
      "properties": {
        "cells": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["address", "content", "value", "alias"],
            "additionalProperties": false,
            "properties": {
              "address": {"type": "string", "pattern": "^[A-Z]{1,3}[0-9]+$"},
              "content": {"type": "string"},
              "value": true,
              "alias": {"$ref": "#/$defs/nullable_string"}
            }
          }
        }
      }
    },
    "varset": {
      "type": "object",
      "required": ["variables"],
      "additionalProperties": false,
      "properties": {
        "variables": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "group", "value", "expression"],
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string"}, "type": {"type": "string"}, "group": {"type": "string"},
              "value": true, "expression": {"$ref": "#/$defs/nullable_string"}
            }
          }
        }
      }
    },
    "body": {
      "type": "object",
      "required": ["tip", "base_feature", "origin", "features"],
      "additionalProperties": false,
      "properties": {
        "tip": {"$ref": "#/$defs/nullable_string"},
        "base_feature": {"$ref": "#/$defs/nullable_string"},
        "origin": {"$ref": "#/$defs/nullable_string"},
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "type", "is_solid_feature", "profile"],
            "additionalProperties": false,
            "properties": {"name": {"type": "string"}, "type": {"type": "string"}, "is_solid_feature": {"type": "boolean"}, "profile": {"$ref": "#/$defs/nullable_string"}}
          }
        }
      }
    },
    "assembly": {
      "type": "object",
      "required": ["components", "joints", "grounded"],
      "additionalProperties": false,
      "properties": {
        "components": {"$ref": "#/$defs/names"},
        "joints": {"$ref": "#/$defs/names"},
        "grounded": {
          "type": "array",
          "items": {"type": "object", "required": ["joint", "object"], "additionalProperties": false, "properties": {"joint": {"type": "string"}, "object": {"$ref": "#/$defs/nullable_string"}}}
        }
      }
    },
    "joint": {
      "type": "object",
      "required": ["joint_type", "reference1", "reference2"],
      "properties": {"joint_type": {"type": "string"}, "reference1": {"$ref": "#/$defs/link"}, "reference2": {"$ref": "#/$defs/link"}}
    },
    "techdraw_page": {
      "type": "object",
      "required": ["template", "template_file", "scale", "views"],
      "additionalProperties": false,
      "properties": {
        "template": {"$ref": "#/$defs/nullable_string"},
        "template_file": {"$ref": "#/$defs/nullable_string"},
        "scale": {"type": "number"},
        "views": {
          "type": "array",
          "items": {"type": "object", "required": ["name", "type"], "additionalProperties": false, "properties": {"name": {"type": "string"}, "type": {"type": "string"}}}
        }
      }
    },
    "techdraw_view": {
      "type": "object",
      "required": ["x", "y", "scale"],
      "additionalProperties": false,
      "properties": {
        "x": {"type": "number"}, "y": {"type": "number"}, "scale": {"type": "number"},
        "sources": {"$ref": "#/$defs/names"},
        "direction": {"$ref": "#/$defs/vec3"},
        "visible_edges": {"type": "integer", "minimum": 0},
        "hidden_edges": {"type": "integer", "minimum": 0}
      }
    },
    "techdraw_dimension": {
      "type": "object",
      "required": ["dimension_type", "references_2d", "references_3d", "text"],
      "additionalProperties": false,
      "properties": {
        "dimension_type": {"type": "string"},
        "references_2d": {"$ref": "#/$defs/link"},
        "references_3d": {"$ref": "#/$defs/link"},
        "text": {"$ref": "#/$defs/nullable_string"},
        "raw_value": {"type": "number"}
      }
    }
  }
}
